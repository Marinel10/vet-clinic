@model VetClinicMvc.ViewModels.CreatePetViewModel

@{
    ViewData["Title"] = "Add New Pet";
}

<h1>Add New Pet</h1>

@if (TempData["Success"] is string success)
{
    <p role="status">@success</p>
}

<form asp-controller="Pets" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Species"></label>
        <input asp-for="Species" />
        <span asp-validation-for="Species"></span>
    </div>
    <div>
        <label asp-for="Breed"></label>
        <input asp-for="Breed" />
        <span asp-validation-for="Breed"></span>
    </div>
    <div>
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" />
        <span asp-validation-for="BirthDate"></span>
    </div>
    <button type="submit">Save Pet</button>
</form>
