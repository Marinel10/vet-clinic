@model RegisterViewModel
<h1>Register</h1>
<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName" class="error"></span>
    <label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="error"></span>
    <label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password" class="error"></span>
    <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="error"></span>
    <button type="submit">Create account</button>
</form>
