@model VetClinicMvc.ViewModels.RescheduleAppointmentViewModel
@{
    ViewData["Title"] = "Reschedule Appointment";
}
<h1>Reschedule Appointment</h1>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<form asp-controller="Appointments" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="StartsAt" class="form-label">New date and time</label>
        <input asp-for="StartsAt" type="datetime-local" class="form-control" />
        <span asp-validation-for="StartsAt" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save new appointment time</button>
</form>
